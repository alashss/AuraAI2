<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp">

        <!-- ── SECTION: Provider ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROVIDER"
            android:textSize="10sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <Spinner
                android:id="@+id/spinnerProvider"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:popupBackground="@color/bg_elevated"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnTestProvider"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Test koneksi"
                    android:textSize="13sp"
                    android:textColor="@color/accent_glow"
                    android:background="@drawable/bg_button_ghost"
                    android:stateListAnimator="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── SECTION: API Keys ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API KEYS"
            android:textSize="10sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp">

            <!-- Gemini -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Gemini" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etGeminiKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="AIza..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- Groq -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Groq" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etGroqKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="gsk_..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- DeepSeek -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DeepSeek" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etDeepseekKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="sk-..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- Claude -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Claude (Anthropic)" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etClaudeKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="sk-ant-..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- OpenAI -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OpenAI" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etOpenaiKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="sk-..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- Mistral -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mistral" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etMistralKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="key..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- Cohere -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Cohere" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etCohereKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="key..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>

            <!-- Together -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Together AI" android:textSize="12sp" android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp" android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/etTogetherKey"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:background="@drawable/bg_input" android:padding="12dp"
                android:hint="key..." android:inputType="textPassword"
                android:textColor="@color/text_primary" android:textColorHint="@color/text_muted"/>
        </LinearLayout>

        <!-- ── SECTION: Settings ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENGATURAN"
            android:textSize="10sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <!-- KKM Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nilai KKM (%)"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"/>
                <EditText
                    android:id="@+id/etKkm"
                    android:layout_width="72dp" android:layout_height="38dp"
                    android:background="@drawable/bg_input"
                    android:padding="8dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border"/>

            <!-- Stealth Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Mode samaran"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Robot transparan saat aktif"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switchStealth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/border"/>

            <!-- Language Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Jawab Bahasa Indonesia"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Semua jawaban dalam Bahasa Indonesia"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switchBahasaIndo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── SAVE BUTTON ── -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Simpan pengaturan"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_button_accent"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>
