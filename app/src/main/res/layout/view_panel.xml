<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel"
    android:padding="14dp"
    android:elevation="20dp">

    <!-- HEADER -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="🤖 AuraAI"
            android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:id="@+id/tvPlatform"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="11sp" android:textColor="#00B4D8"
            android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnClose"
            android:layout_width="28dp" android:layout_height="28dp"
            android:text="✕" android:textSize="11sp" android:padding="0dp"
            android:backgroundTint="#30363D"/>
    </LinearLayout>

    <!-- AUTO CLICK TOGGLE -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_card" android:padding="10dp"
        android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Auto-Click Jawaban"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#E6EDF3"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Klik opsi otomatis setelah AI jawab"
                android:textSize="11sp" android:textColor="#8B949E"/>
        </LinearLayout>
        <Switch android:id="@+id/switchAutoClick"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- SCAN BUTTON -->
    <Button android:id="@+id/btnScan"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="🔍  Scan &amp; Jawab Sekarang"
        android:textSize="13sp" android:textStyle="bold"
        android:backgroundTint="#1458B8"
        android:layout_marginBottom="8dp"/>

    <!-- PROGRESS -->
    <ProgressBar android:id="@+id/progressBar"
        android:layout_width="match_parent" android:layout_height="3dp"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:indeterminate="true"
        android:progressTint="#00B4D8"
        android:visibility="gone"
        android:layout_marginBottom="6dp"/>

    <!-- STATUS -->
    <TextView android:id="@+id/tvStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Tap Scan untuk mulai"
        android:textSize="11sp" android:textColor="#8B949E"
        android:layout_marginBottom="8dp"/>

    <!-- SOAL DETECTED -->
    <TextView android:id="@+id/tvQuestion"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:textColor="#E6EDF3"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"
        android:hint="Soal akan muncul di sini..."
        android:textColorHint="#8B949E"/>

    <!-- JAWABAN AI -->
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxHeight="160dp">
        <TextView android:id="@+id/tvAnswer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_answer"
            android:padding="10dp"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"
            android:hint="Jawaban AI muncul di sini..."
            android:textColorHint="#8B949E"/>
    </ScrollView>

</LinearLayout>
